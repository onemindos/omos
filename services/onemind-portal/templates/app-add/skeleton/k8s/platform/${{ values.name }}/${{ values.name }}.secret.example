# SealedSecret placeholder for ${{ values.title }}. This file is NOT applied (Argo CD only reads *.yaml, *.yml and *.json).
#
# 1. Decide which keys the app needs and list them here as names only. Never write a value in this file.
# 2. Seal them (CLAUDE.md, Secrets):
#      kubeseal --fetch-cert --controller-name=sealed-secrets-controller \
#        --controller-namespace=kube-system > /tmp/pub-cert.pem
#      kubectl create secret generic ${{ values.name }}-secrets -n ${{ values.name }} --from-literal=KEY=value \
#        --dry-run=client -o json | kubeseal --cert /tmp/pub-cert.pem --format yaml --scope namespace-wide \
#        > platform/${{ values.name }}/${{ values.name }}-secrets.sealedsecret.yaml
# 3. Commit the sealed file, delete this placeholder, and never commit plaintext (CI runs gitleaks).
#
# Keys (names only):
#   - EXAMPLE_API_KEY
