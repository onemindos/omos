# Local leaf node; it forwards to the cluster bus.
NATS_URL=nats://localhost:4222
# NATS_USER and NATS_PASSWORD come from the host's secret store, never this file.

GATEWAY_ID=tak-mesh
# SA multicast group used by ATAK/iTAK/WinTAK/VR-TAK.
MESH_GROUP=239.2.3.1:6969
# GeoChat "All Chat Rooms" group; off disables.
MESH_CHAT_GROUP=224.10.10.1:17012
# Interface on the ATAK LAN; used to join AND transmit. Set it on any host with
# more than one network (Wi-Fi, Ethernet, Tailscale): route -n get 239.2.3.1
# MESH_INTERFACE=en0
MESH_TTL=1
# auto = negotiate XML or protobuf per takproto rules; xml = never send protobuf.
MESH_PROTOCOL=auto
# Directed messages (TAK clients' host:port:tcp endpoints). 0 disables.
DIRECT_TCP_PORT=4242
# Unicast UDP input, e.g. an ATAK output pointed here. 0 disables.
UDP_LISTEN_PORT=0
# Also copy mesh CoT to tak.cot.inject so it reaches TAK Server (OM.*, INTEL.*
# and gateway presence are never copied). Keep false outside local testing.
MESH_TO_TAK_SERVER=false
# Acked JetStream publishes on tak.cot.mesh.rx (stream COT via the leaf).
# Set false only where no stream captures that subject.
MESH_RX_JETSTREAM=true

# Mesh encryption (Commo-compatible): MESH_AUTH_KEY and MESH_CIPHER_KEY, two
# different 64-hex-character keys. They are secrets: export them from the host's
# secret store, never write them in this file.

# Data packages: inbox/ and outbox/ under this directory; /getfile port (0 off).
# DATAPKG_DIR=/Users/you/onemind-datapkg
# DATAPKG_HTTP_PORT=8081
# DATAPKG_MAX_BYTES=52428800
# DATAPKG_INBOX_MAX_BYTES=1073741824

# Optional: show the gateway on the map as a contact others can message.
# GATEWAY_CALLSIGN=OneMind
# GATEWAY_ENDPOINT_HOST=192.168.1.10
# GATEWAY_COT_TYPE=a-f-G-E-S
# GATEWAY_LAT=0
# GATEWAY_LON=0
