# Local run against a TAK Server (or test/peer.py) and a local nats-server.
# Certificates are PEM files you mint yourself; never commit them.
NATS_URL=nats://127.0.0.1:4222
TAK_CLIENT_ID=omos-tak-client
TAK_ADDR=127.0.0.1:8089
TAK_CERT_FILE=/path/to/omos-tak-client.pem
TAK_KEY_FILE=/path/to/omos-tak-client.key
TAK_CA_FILE=/path/to/tak-ca.pem
# TAK_SERVER_NAME=takserver          # set to verify the server hostname too
TAK_PROTOCOL=auto                    # auto = accept a TAK Protocol v1 offer; xml = stay on XML
INJECT_ENABLED=true
INJECT_QUEUE=tak-cot-inject          # shared with NatsBridgePlugin 1.1.0+
ECHO_SUPPRESS=true
ECHO_TTL=2m
OUT_JETSTREAM=true                   # needs stream COT (tak.cot.>); false = core publish
HTTP_ADDR=:8080
