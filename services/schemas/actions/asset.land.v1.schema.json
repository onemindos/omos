{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.onemindos.local/actions/asset.land/v1",
  "title": "asset.land v1 parameters",
  "description": "Land now or at a point (A3). Parameters of an ActionRequest (onemind-xr docs/contracts/asset-command.md section 6.1). Unknown fields are refused.",
  "type": "object",
  "required": [],
  "additionalProperties": false,
  "properties": {
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    }
  },
  "dependentRequired": {
    "lat": [
      "lon"
    ],
    "lon": [
      "lat"
    ]
  }
}
