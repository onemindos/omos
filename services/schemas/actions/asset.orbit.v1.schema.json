{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.onemindos.local/actions/asset.orbit/v1",
  "title": "asset.orbit v1 parameters",
  "description": "Orbit a point or a non-person entity (A3). Parameters of an ActionRequest (onemind-xr docs/contracts/asset-command.md section 6.1). Unknown fields are refused.",
  "type": "object",
  "required": [
    "center",
    "radius_m",
    "hae_m",
    "duration_s"
  ],
  "additionalProperties": false,
  "properties": {
    "center": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "lat",
            "lon"
          ],
          "additionalProperties": false,
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          }
        },
        {
          "type": "object",
          "required": [
            "entity_id"
          ],
          "additionalProperties": false,
          "properties": {
            "entity_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
            }
          }
        }
      ]
    },
    "radius_m": {
      "type": "number",
      "minimum": 5,
      "maximum": 2000
    },
    "hae_m": {
      "type": "number",
      "minimum": -500,
      "maximum": 20000
    },
    "duration_s": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7200
    }
  }
}
