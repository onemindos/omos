{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.onemindos.local/tasks/onemind.task.orbit/v1",
  "title": "onemind.task.orbit.v1 spec",
  "description": "Orbit a point or a non-person entity. Task spec (onemind-xr docs/contracts/mission-task.md section 4). Unknown fields are refused.",
  "type": "object",
  "required": [
    "radius_m",
    "hae_m",
    "duration_s"
  ],
  "additionalProperties": false,
  "properties": {
    "center": {
      "type": "object",
      "required": [
        "lat",
        "lon"
      ],
      "additionalProperties": false,
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "target_entity_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
    },
    "radius_m": {
      "type": "number",
      "minimum": 5,
      "maximum": 2000
    },
    "hae_m": {
      "type": "number",
      "minimum": -500,
      "maximum": 20000
    },
    "duration_s": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7200
    }
  },
  "oneOf": [
    {
      "required": [
        "center"
      ]
    },
    {
      "required": [
        "target_entity_id"
      ]
    }
  ]
}
