{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.onemindos.local/map/geofence/v1",
  "title": "KV geofences value v1",
  "description": "One zone in KV geofences (platform/nats/streams/kv-geofences.yaml), key = zone_id. Written only by the geofence service (services/geofence) from policy-approved cmd.map.geofence.* commands. Read by the TAK projector (AOI filter, PR #563 A6-P2), the policy service (keep-in/keep-out checks, PR #554 POL-9) and the layer service. The field set is the union both readers accept (owner proposal D1-P1).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "v",
    "zone_id",
    "entity_id",
    "entity_type",
    "active",
    "live",
    "lifecycle",
    "geo",
    "watch",
    "properties",
    "created_t",
    "updated_t"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "zone_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
    },
    "entity_id": {
      "type": "string",
      "description": "same as zone_id (entity.md: the zone entity mirrored as ent.zone.{id}.state)"
    },
    "entity_type": {
      "const": "zone"
    },
    "name": {
      "type": "string"
    },
    "active": {
      "type": "boolean"
    },
    "live": {
      "type": "boolean",
      "description": "equals active; the policy service reads live"
    },
    "lifecycle": {
      "enum": [
        "active",
        "inactive",
        "removed"
      ]
    },
    "pinned": {
      "type": "boolean"
    },
    "geo": {
      "type": "object",
      "required": [
        "shape",
        "kind",
        "coords"
      ],
      "additionalProperties": false,
      "properties": {
        "shape": {
          "enum": [
            "polygon",
            "multipolygon",
            "circle",
            "corridor"
          ]
        },
        "kind": {
          "enum": [
            "aoi",
            "keep_in",
            "keep_out",
            "hazard",
            "control_area"
          ]
        },
        "coords": {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "enum": [
                "Polygon",
                "MultiPolygon",
                "Point",
                "LineString"
              ]
            },
            "coordinates": {
              "type": "array"
            }
          },
          "description": "GeoJSON geometry, [lon, lat]: Polygon for polygon, MultiPolygon for multipolygon, Point for circle, LineString for corridor"
        },
        "radius_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 200000,
          "description": "circle radius or corridor half-width"
        },
        "alt_min_m": {
          "type": "number"
        },
        "alt_max_m": {
          "type": "number"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "keep_in",
                  "keep_out"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "shape": {
                "enum": [
                  "polygon",
                  "circle"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "shape": {
                "enum": [
                  "circle",
                  "corridor"
                ]
              }
            }
          },
          "then": {
            "required": [
              "radius_m"
            ]
          }
        }
      ]
    },
    "watch": {
      "type": "boolean"
    },
    "watch_types": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,31}$",
        "not": {
          "const": "person"
        }
      },
      "description": "entity types the zone watches; person is refused (civilian stop line)"
    },
    "properties": {
      "type": "object",
      "properties": {
        "applies_to": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_:-]{0,127}$"
          }
        }
      }
    },
    "created_t": {
      "type": "integer"
    },
    "updated_t": {
      "type": "integer"
    },
    "created_by": {
      "type": "string"
    },
    "updated_by": {
      "type": "string"
    },
    "action_id": {
      "type": "string"
    },
    "command_id": {
      "type": "string"
    },
    "simulated": {
      "type": "boolean"
    }
  }
}
