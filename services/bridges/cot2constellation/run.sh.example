#!/bin/bash
# cot2constellation — CoT→Constellation Overwatch Bridge
# Copy this file to run.sh and fill in your credentials.
# run.sh is gitignored — never commit secrets.

export OMOS_NATS="nats://localhost:4222"
export OW_NATS="nats://localhost:4299"
export OW_TRANSPORT="nats"
export OW_NATS_SEED_FILE="/path/to/overwatch.nk"   # NKey seed from Overwatch Admin → API Keys
export COT_SUBJECT="tak.cot.inject"
export OW_API_BASE="http://localhost:8090"
export OW_API_KEY="c4_live_..."                     # Overwatch API key
export OW_ORG_ID="your-org-uuid"                    # Overwatch org ID

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LOG="$SCRIPT_DIR/bridge.log"
exec python3 -u "$SCRIPT_DIR/bridge.py" 2>&1 | tee "$LOG"
