# ═══════════════════════════════════════════════════════════════
# MAVLINK2CONSTELLATION - Runtime Configuration
# ═══════════════════════════════════════════════════════════════
#
# This file configures PHYSICAL CONNECTIONS and INFRASTRUCTURE:
# - MAVLink endpoints (how to receive/forward data)
# - NATS connection settings
# - Performance tuning
#
# Entity IDENTITY is defined in overwatch.yaml:
# - Organization, entity_id, system_id mappings
# - Capabilities, metadata, routing subjects
#
# ═══════════════════════════════════════════════════════════════

# ════════════════════════════════════════════════════════════════
# MAVLINK INPUT - Choose ONE primary input method
# ════════════════════════════════════════════════════════════════

# Option A: Discovery Mode (RECOMMENDED for network/forwarded streams)
# Listens on a single port, auto-discovers all MAVLink sources by system_id
MAVLINK_DISCOVERY_MODE=true
MAVLINK_DISCOVERY_HOST=0.0.0.0
MAVLINK_DISCOVERY_PORT=14550

# Option B: Serial Device (for direct radio/USB connection)
# SERIAL_DEVICE=/dev/ttyUSB0
# SERIAL_BAUD=57600

# Option C: Multiple Serial Devices
# SERIAL_DEVICES=/dev/ttyUSB0,/dev/ttyACM0
# SERIAL_BAUDS=57600,115200

# ════════════════════════════════════════════════════════════════
# MAVLINK OUTPUT - Forward telemetry to GCS, instruments, etc.
# ════════════════════════════════════════════════════════════════

# UDP forwards (comma-separated address:port)
# Example: Forward to QGroundControl
UDP_FORWARDS=127.0.0.1:14555

# TCP server for legacy tools (QGC, Mission Planner via TCP)
ENABLE_TCP_SERVER=false
TCP_SERVER_HOST=0.0.0.0
TCP_SERVER_PORT=5760

# ════════════════════════════════════════════════════════════════
# MAVLINK NODE CONFIGURATION (mavp2p-aligned)
# ════════════════════════════════════════════════════════════════

# Router identity (system_id/component_id for outgoing frames)
MAVLINK_SYSTEM_ID=255
MAVLINK_COMPONENT_ID=190

# Heartbeat emission (disabled by default - we're a bridge, not a GCS)
MAVLINK_HEARTBEAT_DISABLE=true
MAVLINK_HEARTBEAT_PERIOD=5s

# Stream requests for Ardupilot (enable if receiving from Ardupilot directly)
MAVLINK_STREAM_REQ_ENABLE=false
MAVLINK_STREAM_REQ_FREQ=4

# Idle timeout - cleanup inactive channels after this duration
MAVLINK_IDLE_TIMEOUT=60s

# ════════════════════════════════════════════════════════════════
# NATS JETSTREAM - Telemetry streaming and state storage
# ════════════════════════════════════════════════════════════════

NATS_URL=nats://localhost:4222
NATS_AUTH_TOKEN=reindustrialize-america

# Stream for telemetry messages
NATS_STREAM_NAME=CONSTELLATION_TELEMETRY
NATS_ROOT_SUBJECT=constellation

# KV bucket for device state
NATS_KV_BUCKET=CONSTELLATION_GLOBAL_STATE
ENABLE_KV_PUBLISHING=true

# Retention settings
NATS_MAX_AGE=24h
NATS_MAX_MSGS=100000
NATS_MAX_BYTES=1073741824
NATS_STORAGE_TYPE=file

# ════════════════════════════════════════════════════════════════
# PERFORMANCE & MONITORING
# ════════════════════════════════════════════════════════════════

LOG_LEVEL=info
MESSAGE_BUFFER_SIZE=1000

# Async publishing (recommended)
ENABLE_ASYNC_PUBLISHING=true
ASYNC_BATCH_SIZE=100
BATCH_TIMEOUT_MS=50

# Metrics endpoint
ENABLE_METRICS=true
METRICS_PORT=9090

# ════════════════════════════════════════════════════════════════
# TESTING COMMANDS
# ════════════════════════════════════════════════════════════════
#
# Watch all telemetry:
#   nats sub "constellation.telemetry.>"
#
# Watch specific org:
#   nats sub "constellation.telemetry.f65007a0-c7be-4cf2-bb50-b5ac4055d8e7.>"
#
# Watch specific entity:
#   nats sub "constellation.telemetry.f65007a0-c7be-4cf2-bb50-b5ac4055d8e7.e6fe8488-3c7f-4632-97c0-6d6b9b8562fe"
#
# Watch KV state updates:
#   nats kv watch CONSTELLATION_GLOBAL_STATE
#
# Get entity state:
#   nats kv get CONSTELLATION_GLOBAL_STATE e6fe8488-3c7f-4632-97c0-6d6b9b8562fe
#
# ════════════════════════════════════════════════════════════════
