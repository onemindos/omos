<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nats.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/nats-server</string>
        <string>-c</string>
        <string>/Users/zeus/nats-server.conf</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/zeus/nats-data/nats-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/zeus/nats-data/nats-stderr.log</string>
    <key>WorkingDirectory</key>
    <string>/Users/zeus/nats-data</string>
</dict>
</plist>
