{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DroneTelemetry",
  "description": "OMOS RADS drone telemetry envelope payload",
  "type": "object",
  "required": ["drone_id", "lat", "lon", "alt_m", "ts"],
  "properties": {
    "drone_id":  { "type": "string" },
    "lat":       { "type": "number" },
    "lon":       { "type": "number" },
    "alt_m":     { "type": "number" },
    "alt_rel_m": { "type": "number" },
    "ts":        { "type": "number" }
  }
}
