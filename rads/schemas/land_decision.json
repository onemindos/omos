{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LandDecision",
  "description": "Land agent irrigation decision",
  "type": "object",
  "required": ["action", "field", "reason"],
  "properties": {
    "action":   { "type": "string", "enum": ["irrigate", "pause", "resume"] },
    "field":    { "type": "integer" },
    "reason":   { "type": "string" },
    "moisture": { "type": ["number", "null"] }
  }
}
