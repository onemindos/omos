{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AdvancedSkillPayload",
  "description": "Schema for the primary payload used by advanced-skill",
  "type": "object",
  "required": ["input"],
  "properties": {
    "input": {
      "type": "string",
      "description": "The primary input value or identifier",
      "minLength": 1,
      "maxLength": 1000
    },
    "mode": {
      "type": "string",
      "description": "Processing mode",
      "enum": ["standard", "fast", "thorough"],
      "default": "standard"
    },
    "options": {
      "type": "object",
      "description": "Optional configuration flags",
      "properties": {
        "verbose": {
          "type": "boolean",
          "description": "Include debug-level output",
          "default": false
        },
        "timeout_ms": {
          "type": "integer",
          "description": "Custom timeout in milliseconds",
          "minimum": 1000,
          "maximum": 120000,
          "default": 30000
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
