{
  "$schema": "https://openclaw.ai/schema/config/v1",
  "meta": {
    "lastTouchedVersion": "2026.3.7",
    "lastTouchedAt": "2026-03-09T07:31:24.993Z"
  },
  "acp": {
    "enabled": true,
    "dispatch": {
      "enabled": true
    },
    "backend": "acpx",
    "defaultAgent": "legacy",
    "allowedAgents": [
      "legacy",
      "spartan",
      "oracle",
      "eden",
      "empire",
      "haven",
      "guardian",
      "grid",
      "trinity"
    ],
    "maxConcurrentSessions": 8,
    "stream": {
      "coalesceIdleMs": 300,
      "maxChunkChars": 1200
    },
    "runtime": {
      "ttlMinutes": 120
    }
  },
  "models": {
    "providers": {
      "azure-openai": {
        "baseUrl": "https://onemind-openai.openai.azure.com/openai/v1",
        "apiKey": "${APIKEY}",
        "api": "openai-responses",
        "headers": {
          "api-key": "${AZURE_OPENAI_API_KEY}"
        },
        "authHeader": false,
        "models": [
          {
            "id": "gpt-5.2",
            "name": "GPT-5.2",
            "reasoning": true,
            "input": ["text", "image"],
            "compat": {
              "supportsStore": false
            }
          },
          {
            "id": "gpt-5.2-codex",
            "name": "GPT-5.2 Codex",
            "reasoning": true,
            "input": ["text", "image"],
            "compat": {
              "supportsStore": false
            }
          },
          {
            "id": "gpt-5.1-codex-mini",
            "name": "GPT-5.1 Codex Mini",
            "reasoning": true,
            "input": ["text", "image"],
            "compat": {
              "supportsStore": false
            }
          },
          {
            "id": "gpt-5-mini",
            "name": "GPT-5 Mini",
            "input": ["text", "image"],
            "compat": {
              "supportsStore": false
            }
          },
          {
            "id": "gpt-5-nano",
            "name": "GPT-5 Nano",
            "input": ["text", "image"],
            "compat": {
              "supportsStore": false
            }
          },
          {
            "id": "gpt-4o",
            "name": "GPT-4o",
            "input": ["text", "image"],
            "compat": {
              "supportsStore": false
            }
          },
          {
            "id": "gpt-4o-mini",
            "name": "GPT-4o Mini",
            "input": ["text", "image"],
            "compat": {
              "supportsStore": false
            }
          },
          {
            "id": "o1",
            "name": "O1",
            "reasoning": true,
            "input": ["text", "image"],
            "compat": {
              "supportsStore": false
            }
          },
          {
            "id": "o3-mini",
            "name": "O3 Mini",
            "reasoning": true,
            "input": ["text", "image"],
            "compat": {
              "supportsStore": false
            }
          }
        ]
      },
      "openai": {
        "apiKey": "${OPENAI_API_KEY}",
        "models": [
          {
            "id": "gpt-4o",
            "name": "GPT-4o (OpenAI Direct)",
            "input": ["text", "image"]
          },
          {
            "id": "gpt-4o-mini",
            "name": "GPT-4o Mini (OpenAI Direct)",
            "input": ["text", "image"]
          }
        ]
      },
      "anthropic": {
        "apiKey": "${ANTHROPIC_API_KEY}",
        "models": [
          {
            "id": "claude-sonnet-4-20250514",
            "name": "Claude Sonnet 4",
            "input": ["text", "image"]
          },
          {
            "id": "claude-haiku-3-5-20241022",
            "name": "Claude 3.5 Haiku",
            "input": ["text", "image"]
          }
        ]
      }
    },
    "fallback": ["azure-openai", "openai", "anthropic"]
  },
  "agents": {
    "defaults": {
      "model": "azure-openai/gpt-4o",
      "models": {
        "azure-openai/gpt-5.2": {
          "alias": "gpt52"
        },
        "azure-openai/gpt-5-mini": {
          "alias": "gpt5mini"
        },
        "azure-openai/gpt-5-nano": {
          "alias": "gpt5nano"
        },
        "azure-openai/gpt-4o": {
          "alias": "gpt4o"
        },
        "azure-openai/gpt-4o-mini": {
          "alias": "gpt4omini"
        },
        "azure-openai/o1": {
          "alias": "o1"
        },
        "azure-openai/o3-mini": {
          "alias": "o3mini"
        },
        "gradient/llama3.3-70b-instruct": {
          "alias": "llama70b"
        }
      },
      "workspace": "${OPENCLAW_WORKSPACE:-~/.openclaw/workspace}",
      "memorySearch": {
        "enabled": true,
        "sources": ["memory", "sessions"],
        "extraPaths": ["/home/onemind/onemind-os/codex"],
        "experimental": {
          "sessionMemory": true
        },
        "provider": "openai",
        "model": "text-embedding-3-small",
        "store": {
          "vector": {
            "enabled": true
          }
        },
        "sync": {
          "watch": true
        },
        "query": {
          "hybrid": {
            "enabled": true,
            "vectorWeight": 0.7,
            "textWeight": 0.3,
            "candidateMultiplier": 4,
            "mmr": {
              "enabled": true,
              "lambda": 0.7
            },
            "temporalDecay": {
              "enabled": true,
              "halfLifeDays": 30
            }
          }
        },
        "cache": {
          "enabled": true,
          "maxEntries": 50000
        }
      },
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "1h"
      },
      "compaction": {
        "mode": "safeguard",
        "reserveTokensFloor": 20000,
        "memoryFlush": {
          "enabled": true,
          "softThresholdTokens": 4000,
          "prompt": "Write any lasting notes to memory/2026-03-16.md; reply with NO_REPLY if nothing to store.",
          "systemPrompt": "Session nearing compaction. Store durable memories now."
        }
      },
      "thinkingDefault": "medium",
      "subagents": {
        "maxConcurrent": 8,
        "maxSpawnDepth": 3,
        "maxChildrenPerAgent": 5,
        "model": "azure-openai/gpt-4o-mini"
      }
    },
    "list": [
      {
        "id": "legacy",
        "default": true,
        "workspace": "/home/onemind/onemind-os/openclaw/workspaces/legacy",
        "model": "azure-openai/gpt-5.2",
        "tools": {
          "profile": "full",
          "alsoAllow": ["lobster"]
        }
      },
      {
        "id": "spartan",
        "workspace": "/home/onemind/onemind-os/openclaw/workspaces/spartan",
        "model": "azure-openai/gpt-4o",
        "tools": {
          "profile": "messaging",
          "allow": [
            "web_fetch",
            "web_search",
            "memory_search",
            "memory_get",
            "lobster",
            "read",
            "write",
            "edit"
          ]
        }
      },
      {
        "id": "oracle",
        "workspace": "/home/onemind/onemind-os/openclaw/workspaces/oracle",
        "model": "azure-openai/gpt-4o",
        "tools": {
          "profile": "messaging",
          "allow": [
            "web_fetch",
            "web_search",
            "memory_search",
            "memory_get",
            "lobster",
            "read",
            "write",
            "edit"
          ]
        }
      },
      {
        "id": "eden",
        "workspace": "/home/onemind/onemind-os/openclaw/workspaces/eden",
        "model": "azure-openai/gpt-4o",
        "tools": {
          "profile": "messaging",
          "allow": [
            "web_fetch",
            "web_search",
            "memory_search",
            "memory_get",
            "lobster",
            "read",
            "write",
            "edit"
          ]
        }
      },
      {
        "id": "haven",
        "workspace": "/home/onemind/onemind-os/openclaw/workspaces/haven",
        "model": "azure-openai/gpt-4o",
        "tools": {
          "profile": "messaging",
          "allow": [
            "web_fetch",
            "web_search",
            "memory_search",
            "memory_get",
            "lobster",
            "read",
            "write",
            "edit"
          ]
        }
      },
      {
        "id": "empire",
        "workspace": "/home/onemind/onemind-os/openclaw/workspaces/empire",
        "model": "azure-openai/gpt-5.2",
        "tools": {
          "profile": "messaging",
          "allow": [
            "web_fetch",
            "web_search",
            "memory_search",
            "memory_get",
            "lobster",
            "read",
            "write",
            "edit"
          ]
        }
      },
      {
        "id": "guardian",
        "workspace": "/home/onemind/onemind-os/openclaw/workspaces/guardian",
        "model": "azure-openai/gpt-4o",
        "tools": {
          "profile": "messaging",
          "allow": [
            "web_fetch",
            "web_search",
            "memory_search",
            "memory_get",
            "lobster",
            "read",
            "write",
            "edit"
          ]
        }
      },
      {
        "id": "grid",
        "workspace": "/home/onemind/onemind-os/openclaw/workspaces/grid",
        "model": "azure-openai/gpt-4o",
        "tools": {
          "profile": "messaging",
          "allow": [
            "web_fetch",
            "web_search",
            "memory_search",
            "memory_get",
            "lobster",
            "read",
            "write",
            "edit"
          ]
        }
      },
      {
        "id": "trinity",
        "workspace": "/home/onemind/onemind-os/openclaw/workspaces/trinity",
        "model": "azure-openai/gpt-4o",
        "tools": {
          "profile": "messaging",
          "allow": [
            "web_fetch",
            "web_search",
            "memory_search",
            "memory_get",
            "lobster",
            "read",
            "write",
            "edit"
          ]
        }
      }
    ]
  },
  "tools": {
    "web": {
      "search": {
        "enabled": true,
        "maxResults": 8
      },
      "fetch": {
        "enabled": true,
        "maxCharsCap": 50000
      }
    },
    "loopDetection": {
      "enabled": true,
      "warningThreshold": 10,
      "criticalThreshold": 20
    },
    "agentToAgent": {
      "enabled": true,
      "allow": [
        "legacy",
        "spartan",
        "oracle",
        "eden",
        "empire",
        "haven",
        "guardian",
        "grid",
        "trinity"
      ]
    },
    "exec": {
      "host": "gateway",
      "security": "full",
      "applyPatch": {
        "enabled": true
      }
    }
  },
  "bindings": [
    {
      "agentId": "spartan",
      "match": {
        "channel": "discord",
        "peer": {
          "kind": "channel",
          "id": "${DISCORD_SPARTAN_CHANNEL_ID}"
        }
      }
    },
    {
      "agentId": "oracle",
      "match": {
        "channel": "discord",
        "peer": {
          "kind": "channel",
          "id": "${DISCORD_ORACLE_CHANNEL_ID}"
        }
      }
    },
    {
      "agentId": "eden",
      "match": {
        "channel": "discord",
        "peer": {
          "kind": "channel",
          "id": "${DISCORD_EDEN_CHANNEL_ID}"
        }
      }
    },
    {
      "agentId": "empire",
      "match": {
        "channel": "discord",
        "peer": {
          "kind": "channel",
          "id": "${DISCORD_EMPIRE_CHANNEL_ID}"
        }
      }
    },
    {
      "agentId": "haven",
      "match": {
        "channel": "discord",
        "peer": {
          "kind": "channel",
          "id": "${DISCORD_HAVEN_CHANNEL_ID}"
        }
      }
    },
    {
      "agentId": "guardian",
      "match": {
        "channel": "discord",
        "peer": {
          "kind": "channel",
          "id": "${DISCORD_GUARDIAN_CHANNEL_ID}"
        }
      }
    },
    {
      "agentId": "grid",
      "match": {
        "channel": "discord",
        "peer": {
          "kind": "channel",
          "id": "${DISCORD_GRID_CHANNEL_ID}"
        }
      }
    },
    {
      "agentId": "trinity",
      "match": {
        "channel": "discord",
        "peer": {
          "kind": "channel",
          "id": "${DISCORD_TRINITY_CHANNEL_ID}"
        }
      }
    }
  ],
  "broadcast": {
    "strategy": "parallel"
  },
  "messages": {
    "tts": {
      "provider": "openai",
      "openai": {
        "apiKey": "${AZURE_OPENAI_API_KEY}",
        "baseUrl": "${AZURE_OPENAI_ENDPOINT}/openai/deployments/tts/audio/speech?api-version=2024-12-17",
        "model": "tts-1",
        "voice": "alloy"
      }
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "cron": {
    "enabled": true,
    "maxConcurrentRuns": 3
  },
  "hooks": {
    "enabled": true,
    "path": "/hooks",
    "token": "${TOKEN}",
    "defaultSessionKey": "hook:ingress",
    "allowedAgentIds": [
      "legacy",
      "spartan",
      "oracle",
      "eden",
      "empire",
      "haven",
      "guardian",
      "grid",
      "trinity"
    ],
    "presets": ["gmail"],
    "mappings": [
      {
        "id": "nats-event",
        "match": {
          "source": "nats"
        },
        "action": "wake"
      },
      {
        "id": "agno-result",
        "action": "agent",
        "agentId": "legacy",
        "deliver": true,
        "channel": "last"
      },
      {
        "id": "ha-alert",
        "action": "agent",
        "agentId": "legacy",
        "deliver": true,
        "channel": "discord",
        "to": "${HEARTBEAT_CHANNEL_ID}"
      }
    ],
    "internal": {
      "entries": {
        "session-memory": {
          "enabled": true,
          "messages": 25
        }
      }
    }
  },
  "channels": {
    "discord": {
      "enabled": true,
      "token": "${TOKEN}",
      "groupPolicy": "open",
      "streaming": "partial",
      "dmPolicy": "open",
      "allowFrom": ["*"],
      "guilds": {
        "${DISCORD_GUILD_ID}": {
          "requireMention": false,
          "channels": {
            "${HEARTBEAT_CHANNEL_ID}": {
              "allow": true
            },
            "${DISCORD_SPARTAN_CHANNEL_ID}": {
              "allow": true
            },
            "${DISCORD_ORACLE_CHANNEL_ID}": {
              "allow": true
            },
            "${DISCORD_EDEN_CHANNEL_ID}": {
              "allow": true
            },
            "${DISCORD_HAVEN_CHANNEL_ID}": {
              "allow": true
            },
            "${DISCORD_EMPIRE_CHANNEL_ID}": {
              "allow": true
            },
            "${DISCORD_TRINITY_CHANNEL_ID}": {
              "allow": true
            },
            "${DISCORD_GRID_CHANNEL_ID}": {
              "allow": true
            },
            "${DISCORD_GUARDIAN_CHANNEL_ID}": {
              "allow": true
            }
          }
        }
      },
      "threadBindings": {
        "enabled": true,
        "idleHours": 24,
        "spawnSubagentSessions": true
      },
      "voice": {
        "enabled": true,
        "autoJoin": [],
        "daveEncryption": true,
        "decryptionFailureTolerance": 24,
        "tts": {
          "provider": "openai",
          "openai": {
            "apiKey": "${AZURE_OPENAI_API_KEY}",
            "baseUrl": "${AZURE_OPENAI_ENDPOINT}/openai/deployments/tts/audio/speech?api-version=2024-12-17",
            "model": "tts-1",
            "voice": "alloy"
          }
        }
      }
    },
    "bluebubbles": {
      "enabled": true,
      "serverUrl": "${BLUEBUBBLES_SERVER_URL}",
      "password": "${BLUEBUBBLES_PASSWORD}",
      "webhookPath": "/bluebubbles-webhook",
      "dmPolicy": "open",
      "allowFrom": ["*"],
      "groupPolicy": "allowlist"
    }
  },
  "talk": {
    "interruptOnSpeech": true
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "loopback",
    "rateLimits": {
      "perToken": {
        "requests": 120,
        "perSeconds": 60,
        "burst": 30
      },
      "perAgent": {
        "maxConcurrentSessions": 8
      }
    },
    "controlUi": {
      "allowedOrigins": [
        "https://*.tail717ba0.ts.net",
        "http://*.tail717ba0.ts.net",
        "https://onemind-main.tail717ba0.ts.net",
        "https://onemind-gateway.tail717ba0.ts.net",
        "http://localhost:3000",
        "http://localhost:3456",
        "http://127.0.0.1:3000",
        "http://127.0.0.1:3456",
        "https://gateway.onemindos.dev",
        "https://office.onemindos.dev",
        "https://swarm.onemindos.dev",
        "https://nats.onemindos.dev",
        "https://*.onemindos.dev"
      ],
      "dangerouslyAllowHostHeaderOriginFallback": false,
      "allowInsecureAuth": false,
      "dangerouslyDisableDeviceAuth": false
    },
    "auth": {
      "token": "${TOKEN}"
    },
    "tailscale": {
      "mode": "serve"
    },
    "trustedProxies": ["100.64.0.0/10", "127.0.0.1", "::1", "::ffff:127.0.0.1"]
  },
  "skills": {
    "load": {
      "watch": true,
      "watchDebounceMs": 250
    },
    "install": {
      "preferBrew": false,
      "nodeManager": "npm"
    }
  },
  "plugins": {
    "slots": {
      "memory": "memory-core"
    },
    "entries": {
      "lobster": {
        "enabled": true
      },
      "bluebubbles": {
        "enabled": true
      },
      "diffs": {
        "enabled": true
      },
      "llm-task": {
        "enabled": true
      },
      "open-prose": {
        "enabled": true
      },
      "diagnostics-otel": {
        "enabled": true,
        "config": {}
      },
      "acpx": {
        "enabled": true
      }
    }
  }
}
