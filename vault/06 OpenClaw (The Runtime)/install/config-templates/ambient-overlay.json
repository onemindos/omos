{
  "$comment": "Ambient presence config overlay — merge into openclaw.json for always-on mode",

  "agents": {
    "defaults": {
      "heartbeat": {
        "every": "5m",
        "target": "last",
        "directPolicy": "allow",
        "lightContext": false,
        "model": "azure-openai/gpt-4o-mini",
        "prompt": "Read HEARTBEAT.md. Read AMBIENT_STATE.md if it exists. You are Legacy — always-on AI presence for Zeus. Scan current state: vision digest, NATS events, active session. Surface anything actionable. If nothing needs attention, reply HEARTBEAT_OK.",
        "ackMaxChars": 500,
        "activeHours": {
          "start": "06:00",
          "end": "23:59",
          "timezone": "America/New_York"
        }
      }
    },
    "list": [
      {
        "id": "legacy",
        "heartbeat": {
          "every": "5m",
          "target": "last",
          "lightContext": false,
          "model": "azure-openai/gpt-4o"
        }
      }
    ]
  },

  "plugins": {
    "entries": {
      "discord-voice": {
        "enabled": true,
        "config": {
          "sttProvider": "deepgram",
          "ttsProvider": "azure-openai",
          "vadSensitivity": "medium",
          "silenceThresholdMs": 800,
          "maxRecordingMs": 60000,
          "barge_in": true,
          "azure-openai": {
            "voice": "alloy",
            "model": "tts-1"
          },
          "deepgram": {
            "model": "nova-3",
            "language": "en"
          }
        }
      }
    }
  },

  "tools": {
    "shell": {
      "enabled": true,
      "allowedCommands": ["cat", "nats", "date", "jq", "python3"]
    }
  }
}
