[Unit]
Description=Legacy Pulse — NATS Event Bridge for OpenClaw
After=network.target docker.service openclaw.service
Requires=docker.service

[Service]
Type=simple
User=onemind
Group=onemind
Environment=NATS_URL=nats://localhost:4222
Environment=OPENCLAW_WORKSPACE=/home/onemind/.openclaw/workspace
ExecStart=/usr/bin/python3 /home/onemind/onemind-os/openclaw/workspaces/legacy/skills/legacy-pulse/legacy-pulse.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
