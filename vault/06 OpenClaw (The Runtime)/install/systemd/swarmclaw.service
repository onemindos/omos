[Unit]
Description=OneMind OS — SwarmClaw (Agent Orchestration Dashboard)
After=network-online.target openclaw.service
Wants=network-online.target

[Service]
Type=simple
User=onemind
Group=onemind
WorkingDirectory=/home/onemind/onemind-os/command-center/swarmclaw
Environment=NODE_ENV=production
Environment=PORT=3456
Environment=HOSTNAME=127.0.0.1
EnvironmentFile=-/opt/onemind/.env.sa
ExecStart=/usr/bin/node .next/standalone/server.js
Restart=always
RestartSec=10
StartLimitBurst=5
StartLimitIntervalSec=300
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=swarmclaw

[Install]
WantedBy=multi-user.target
