[Unit]
Description=OneMind — auto-commit OpenClaw config changes to GitHub
After=openclaw.service
Wants=openclaw.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
Environment=HOME=/home/ubuntu
ExecStart=/home/ubuntu/openclaw-config-sync.sh
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openclaw-config-sync

[Install]
WantedBy=multi-user.target
