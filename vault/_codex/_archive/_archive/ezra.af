              "type": "text",
              "text": "Here's a complete multi-agent system with shared memory, custom tools, and coordination logic:\n\n```python\n#!/usr/bin/env python3\n\"\"\"\nComplete Multi-Agent System with Shared Memory\nDemonstrates: agent creation, shared archives, shared memory blocks, \ncustom tools, agent-to-agent coordination, and memory management.\n\"\"\"\n\nimport os\nfrom letta_client import Letta\nfrom dotenv import load_dotenv\nimport time\n\n# Load environment variables\nload_dotenv()\n\n# Initialize Letta client\nclient = Letta(token=os.getenv('LETTA_API_KEY'))\n\nprint(\"=== Multi-Agent System Setup ===\\n\")\n\n# Step 1: Create shared memory blocks\nprint(\"1. Creating shared memory blocks...\")\nshared_context = client.blocks.create(\n    label=\"shared_context\",\n    value=\"Project: AI Research Assistant System\\nStatus: Active\\nTeam: 3 agents\\nGoal: Coordinate research and documentation\",\n    description=\"Shared context accessible to all agents\"\n)\n\nshared_knowledge = client.blocks.create(\n    label=\"shared_knowledge\", \n    value=\"Key Facts:\\n- Project deadline: Dec 31, 2025\\n- Focus areas: NLP, agent architectures\\n- Documentation format: Markdown\",\n    description=\"Shared knowledge base\"\n)\n\nprint(f\"Created shared blocks: {shared_context.id}, {shared_knowledge.id}\\n\")\n\n# Step 2: Create shared archive for long-term memory\nprint(\"2. Creating shared archive...\")\narchive = client.archives.create(\n    name=\"team_archive\",\n    description=\"Shared long-term memory for research team\"\n)\n\n# Seed the archive with initial knowledge\ninitial_knowledge = [\n    \"Research focus: Multi-agent coordination patterns in LLM systems\",\n    \"Key papers: MemGPT (2023), ReAct (2022), Reflexion (2023)\",\n    \"Team workflow: Research → Analysis → Documentation → Review\",\n    \"Quality standards: All claims must cite sources\",\n    \"Communication protocol: Agents update shared_knowledge block with findings\"\n]\n\nfor knowledge in initial_knowledge:\n    client.archival_memory.insert(\n        archive_id=archive.id,\n        content=knowledge\n    )\n\nprint(f\"Created archive: {archive.id}\\n\")\n\n# Step 3: Define custom tool for agent coordination\nprint(\"3. Creating custom coordination tool...\")\n\ndef report_finding(finding: str, category: str) -> str:\n    \"\"\"\n    Report a research finding to the shared knowledge base.\n    \n    Args:\n        finding: The research finding to report\n        category: Category (research/analysis/documentation)\n    \n    Returns:\n        Confirmation message\n    \"\"\"\n    # Note: In real implementation, this would update shared memory\n    # For demo purposes, we're showing the structure\n    import datetime\n    timestamp = datetime.datetime.now().isoformat()\n    return f\"Finding logged at {timestamp}: [{category}] {finding}\"\n\n# Create tool in Letta\ntool = client.tools.create(\n    name=\"report_finding\",\n    source_code=\"\"\"\ndef report_finding(finding: str, category: str) -> str:\n    '''\n    Report a research finding to the shared knowledge base.\n    \n    Args:\n        finding: The research finding to report\n        category: Category (research/analysis/documentation)\n    \n    Returns:\n        Confirmation message\n    '''\n    import datetime\n    timestamp = datetime.datetime.now().isoformat()\n    return f\"Finding logged at {timestamp}: [{category}] {finding}\"\n\"\"\",\n    source_type=\"python\"\n)\n\nprint(f\"Created tool: {tool.id}\\n\")\n\n# Step 4: Create coordinated agents\nprint(\"4. Creating agent team...\\n\")\n\n# Agent 1: Research Specialist\nresearch_agent = client.agents.create(\n    name=\"Research Agent\",\n    memory_blocks=[\n        {\"label\": \"persona\", \"value\": \"You are a research specialist. Your job is to find and analyze academic papers and technical resources. You use the report_finding tool to share discoveries with the team.\"},\n        {\"block_id\": shared_context.id},\n        {\"block_id\": shared_knowledge.id}\n    ],\n    llm_config={\n        \"model\": \"openai/gpt-4o-mini\",\n        \"context_window\": 32000\n    },\n    embedding_config={\n        \"embedding_model\": \"text-embedding-3-small\"\n    },\n    tools=[tool.id]\n)\n\n# Attach archive\nclient.agents.attach_archive(agent_id=research_agent.id, archive_id=archive.id)\nprint(f\"✓ Created Research Agent: {research_agent.id}\")\n\n# Agent 2: Analysis Specialist  \nanalysis_agent = client.agents.create(\n    name=\"Analysis Agent\",\n    memory_blocks=[\n        {\"label\": \"persona\", \"value\": \"You are an analysis specialist. You synthesize research findings into insights and identify patterns. You use the report_finding tool to share analysis results.\"},\n        {\"block_id\": shared_context.id},\n        {\"block_id\": shared_knowledge.id}\n    ],\n    llm_config={\n        \"model\": \"openai/gpt-4o-mini\",\n        \"context_window\": 32000\n    },\n    embedding_config={\n        \"embedding_model\": \"text-embedding-3-small\"\n    },\n    tools=[tool.id]\n)\n\nclient.agents.attach_archive(agent_id=analysis_agent.id, archive_id=archive.id)\nprint(f\"✓ Created Analysis Agent: {analysis_agent.id}\")\n\n# Agent 3: Documentation Specialist\ndoc_agent = client.agents.create(\n    name=\"Documentation Agent\",\n    memory_blocks=[\n        {\"label\": \"persona\", \"value\": \"You are a documentation specialist. You create clear, comprehensive documentation from research and analysis. You use the report_finding tool to share completed documentation.\"},\n        {\"block_id\": shared_context.id},\n        {\"block_id\": shared_knowledge.id}\n    ],\n    llm_config={\n        \"model\": \"openai/gpt-4o-mini\",\n        \"context_window\": 32000\n    },\n    embedding_config={\n        \"embedding_model\": \"text-embedding-3-small\"\n    },\n    tools=[tool.id]\n)\n\nclient.agents.attach_archive(agent_id=doc_agent.id, archive_id=archive.id)\nprint(f\"✓ Created Documentation Agent: {doc_agent.id}\\n\")\n\n# Step 5: Demonstrate coordination workflow\nprint(\"5. Testing agent coordination...\\n\")\n\n# Research agent finds something\nprint(\"→ Research Agent: Finding information...\")\nresponse1 = client.agents.messages.create(\n    agent_id=research_agent.id,\n    messages=[{\n        \"role\": \"user\",\n        \"content\": \"Search the archive for information about multi-agent coordination patterns. What do we know?\"\n    }]\n)\n\nprint(f\"Research Agent response received ({len(response1.messages)} messages)\")\n\n# Update shared knowledge based on research\nprint(\"\\n→ Updating shared knowledge block...\")\ncurrent_knowledge = client.blocks.retrieve(block_id=shared_knowledge.id)\nupdated_value = current_knowledge.value + f\"\\n- Last research: {time.strftime('%Y-%m-%d %H:%M')}\"\n\nclient.blocks.update(\n    block_id=shared_knowledge.id,\n    value=updated_value\n)\n\n# Analysis agent reads updated knowledge\nprint(\"\\n→ Analysis Agent: Reviewing updated knowledge...\")\nresponse2 = client.agents.messages.create(\n    agent_id=analysis_agent.id,\n    messages=[{\n        \"role\": \"user\", \n        \"content\": \"Check the shared_knowledge block. What's our current project status and latest research?\"\n    }]\n)\n\nprint(f\"Analysis Agent response received ({len(response2.messages)} messages)\")\n\n# Documentation agent creates summary\nprint(\"\\n→ Documentation Agent: Creating documentation...\")\nresponse3 = client.agents.messages.create(\n    agent_id=doc_agent.id,\n    messages=[{\n        \"role\": \"user\",\n        \"content\": \"Based on the shared_knowledge block, create a brief project status summary.\"\n    }]\n)\n\nprint(f\"Documentation Agent response received ({len(response3.messages)} messages)\")\n\n# Step 6: Display final state\nprint(\"\\n\" + \"=\"*50)\nprint(\"FINAL SYSTEM STATE\")\nprint(\"=\"*50)\n\nprint(f\"\\nShared Archive: {archive.id}\")\nprint(f\"Shared Context Block: {shared_context.id}\")\nprint(f\"Shared Knowledge Block: {shared_knowledge.id}\")\nprint(f\"Custom Tool: {tool.id}\")\n\nprint(f\"\\nAgent Team:\")\nprint(f\"  - Research Agent: {research_agent.id}\")\nprint(f\"  - Analysis Agent: {analysis_agent.id}\")\nprint(f\"  - Documentation Agent: {doc_agent.id}\")\n\nprint(\"\\n✓ Multi-agent system setup complete!\")\nprint(\"\\nAll agents share:\")\nprint(\"  • Common memory blocks (context + knowledge)\")\nprint(\"  • Shared archive for long-term memory\")\nprint(\"  • Custom coordination tool\")\nprint(\"\\nAgents can now work independently while maintaining shared state.\")\n```\n\nThis example shows the full lifecycle of a coordinated multi-agent system with shared memory infrastructure.",
