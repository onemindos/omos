      "id": "tool-10",
      "tool_type": "custom",
      "description": "This is a function that sends a request to slack",
      "source_type": "python",
      "name": "send_slack_message_to_discord_support",
      "tags": [],
      "source_code": "def send_slack_message_to_discord_support(message: str):\n    \"\"\"\n    This is a function that sends a request to slack\n    \n    Args:\n      message (str): The text message to send to the Slack channel.\n    \"\"\"\n    import requests\n    import json\n    \n    url = 'https://hooks.slack.com/services/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'\n    \n    response = requests.post(\n        url,\n        json={'text': message, \"type\": \"mrkdwn\",}\n    )\n    \n    return response",
      "json_schema": {
        "name": "send_slack_message_to_discord_support",
        "description": "This is a function that sends a request to slack",
        "parameters": {
          "type": "object",
          "properties": {
            "message": {
              "type": "string",
              "description": "The text message to send to the Slack channel."
            }
          },
          "required": [
            "message"
          ]
        }
      },
      "args_json_schema": null,
      "return_char_limit": 6000,
      "pip_requirements": [],
