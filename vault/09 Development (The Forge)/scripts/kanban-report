#!/usr/bin/env python3
"""
kanban-report — Daily summary of Hermes Kanban tasks.

Usage: kanban-report [--days N] [--db PATH]
"""
from __future__ import annotations

import argparse
import sqlite3
import sys
import time
import os
from datetime import datetime, timezone
from typing import Optional, List


# ---------------------------------------------------------------------------
# DB helpers
# ---------------------------------------------------------------------------

DEFAULT_DB = os.path.expanduser("~/.hermes/kanban.db")


def open_db(path: str) -> sqlite3.Connection:
    if not os.path.exists(path):
        print(f"ERROR: kanban.db not found at {path}", file=sys.stderr)
        sys.exit(1)
    conn = sqlite3.connect(path)
    conn.row_factory = sqlite3.Row
    return conn


def since_epoch(days: int) -> int:
    return int(time.time()) - days * 86400


def fmt_duration(seconds: Optional[float]) -> str:
    if seconds is None:
        return "—"
    seconds = int(seconds)
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m {seconds % 60}s"
    h = seconds // 3600
    m = (seconds % 3600) // 60
    return f"{h}h {m}m"


def fmt_ts(epoch: Optional[int]) -> str:
    if epoch is None:
        return "—"
    dt = datetime.fromtimestamp(epoch, tz=timezone.utc).astimezone()
    return dt.strftime("%Y-%m-%d %H:%M")


def truncate(s: Optional[str], n: int = 60) -> str:
    if not s:
        return "—"
    s = s.replace("\n", " ").strip()
    return s if len(s) <= n else s[: n - 1] + "…"


# ---------------------------------------------------------------------------
# Queries
# ---------------------------------------------------------------------------

def get_completed(conn: sqlite3.Connection, since: int) -> list[sqlite3.Row]:
    return conn.execute(
        """
        SELECT t.id, t.title, t.assignee,
               t.started_at, t.completed_at,
               (t.completed_at - t.started_at) AS duration_s,
               r.summary
        FROM   tasks t
        LEFT JOIN task_runs r
               ON r.task_id = t.id AND r.outcome = 'completed'
               AND r.ended_at = (
                   SELECT MAX(r2.ended_at) FROM task_runs r2
                   WHERE r2.task_id = t.id AND r2.outcome = 'completed'
               )
        WHERE  t.status = 'done'
          AND  t.completed_at >= ?
        ORDER  BY t.completed_at DESC
        """,
        (since,),
    ).fetchall()


def get_in_progress(conn: sqlite3.Connection) -> list[sqlite3.Row]:
    now = int(time.time())
    return conn.execute(
        """
        SELECT id, title, assignee, started_at,
               (? - started_at) AS age_s
        FROM   tasks
        WHERE  status IN ('running', 'ready', 'todo')
        ORDER  BY started_at ASC NULLS LAST
        """,
        (now,),
    ).fetchall()


def get_failed(conn: sqlite3.Connection, since: int) -> list[sqlite3.Row]:
    return conn.execute(
        """
        SELECT t.id, t.title, t.assignee, t.last_failure_error,
               t.completed_at,
               r.error AS run_error, r.outcome
        FROM   tasks t
        LEFT JOIN task_runs r
               ON r.task_id = t.id
               AND r.ended_at = (
                   SELECT MAX(r2.ended_at) FROM task_runs r2
                   WHERE r2.task_id = t.id AND r2.outcome IN ('crashed','timed_out','gave_up','spawn_failed')
               )
        WHERE  t.status = 'failed'
          AND  (t.completed_at >= ? OR t.completed_at IS NULL)
        ORDER  BY t.completed_at DESC NULLS LAST
        LIMIT  50
        """,
        (since,),
    ).fetchall()


# ---------------------------------------------------------------------------
# Plain-text renderer
# ---------------------------------------------------------------------------

def plain_report(completed, in_progress, failed, days: int) -> None:
    divider = "=" * 72
    subdiv = "-" * 72

    print(divider)
    print(f"  KANBAN DAILY REPORT — last {days} day(s)  ({fmt_ts(int(time.time()))})")
    print(divider)

    # ---- Completed ----
    print(f"\n  COMPLETED  ({len(completed)} tasks)\n" + subdiv)
    if not completed:
        print("  (none)")
    else:
        header = f"{'TITLE':<42} {'ASSIGNEE':<14} {'COMPLETED':<17} {'DURATION'}"
        print("  " + header)
        for r in completed:
            title = truncate(r["title"], 40)
            assignee = (r["assignee"] or "—")[:13]
            completed_at = fmt_ts(r["completed_at"])
            duration = fmt_duration(r["duration_s"])
            print(f"  {title:<42} {assignee:<14} {completed_at:<17} {duration}")

    # ---- In Progress ----
    print(f"\n  IN PROGRESS  ({len(in_progress)} tasks)\n" + subdiv)
    if not in_progress:
        print("  (none)")
    else:
        header = f"{'TITLE':<42} {'ASSIGNEE':<14} {'STATUS':<10} {'AGE'}"
        print("  " + header)
        for r in in_progress:
            title = truncate(r["title"], 40)
            assignee = (r["assignee"] or "—")[:13]
            age = fmt_duration(r["age_s"])
            print(f"  {title:<42} {assignee:<14} {'running':<10} {age}")

    # ---- Failed ----
    print(f"\n  FAILED  ({len(failed)} tasks)\n" + subdiv)
    if not failed:
        print("  (none)")
    else:
        header = f"{'TITLE':<42} {'ASSIGNEE':<14} {'ERROR'}"
        print("  " + header)
        for r in failed:
            title = truncate(r["title"], 40)
            assignee = (r["assignee"] or "—")[:13]
            err = truncate(r["run_error"] or r["last_failure_error"], 40)
            print(f"  {title:<42} {assignee:<14} {err}")

    print("\n" + divider + "\n")


# ---------------------------------------------------------------------------
# Rich renderer
# ---------------------------------------------------------------------------

def rich_report(completed, in_progress, failed, days: int) -> None:
    from rich.console import Console
    from rich.table import Table
    from rich import box
    from rich.panel import Panel
    from rich.text import Text

    console = Console()

    ts = fmt_ts(int(time.time()))
    console.print(
        Panel(
            f"[bold cyan]Kanban Daily Report[/bold cyan]  [dim]last {days} day(s) · {ts}[/dim]",
            expand=True,
            border_style="cyan",
        )
    )

    # ---- Completed ----
    t = Table(
        title=f"[green]Completed[/green]  ({len(completed)})",
        box=box.SIMPLE_HEAD,
        show_lines=False,
        highlight=True,
    )
    t.add_column("Title", style="white", max_width=50)
    t.add_column("Assignee", style="cyan", max_width=16)
    t.add_column("Completed", style="dim", max_width=18)
    t.add_column("Duration", style="yellow", justify="right")
    for r in completed:
        t.add_row(
            truncate(r["title"], 50),
            r["assignee"] or "—",
            fmt_ts(r["completed_at"]),
            fmt_duration(r["duration_s"]),
        )
    if not completed:
        t.add_row("[dim](none)[/dim]", "", "", "")
    console.print(t)

    # ---- In Progress ----
    t2 = Table(
        title=f"[yellow]In Progress[/yellow]  ({len(in_progress)})",
        box=box.SIMPLE_HEAD,
        show_lines=False,
        highlight=True,
    )
    t2.add_column("Title", style="white", max_width=50)
    t2.add_column("Assignee", style="cyan", max_width=16)
    t2.add_column("Status", style="dim", max_width=10)
    t2.add_column("Age", style="yellow", justify="right")
    for r in in_progress:
        t2.add_row(
            truncate(r["title"], 50),
            r["assignee"] or "—",
            "running",
            fmt_duration(r["age_s"]),
        )
    if not in_progress:
        t2.add_row("[dim](none)[/dim]", "", "", "")
    console.print(t2)

    # ---- Failed ----
    t3 = Table(
        title=f"[red]Failed[/red]  ({len(failed)})",
        box=box.SIMPLE_HEAD,
        show_lines=False,
        highlight=True,
    )
    t3.add_column("Title", style="white", max_width=44)
    t3.add_column("Assignee", style="cyan", max_width=16)
    t3.add_column("Error", style="red dim", max_width=46)
    for r in failed:
        t3.add_row(
            truncate(r["title"], 44),
            r["assignee"] or "—",
            truncate(r["run_error"] or r["last_failure_error"], 46),
        )
    if not failed:
        t3.add_row("[dim](none)[/dim]", "", "")
    console.print(t3)


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

def main() -> None:
    parser = argparse.ArgumentParser(
        description="Show a Hermes Kanban task summary for the last N days."
    )
    parser.add_argument(
        "--days", "-d", type=int, default=7, metavar="N",
        help="Number of days to look back (default: 7)"
    )
    parser.add_argument(
        "--db", default=DEFAULT_DB, metavar="PATH",
        help=f"Path to kanban.db (default: {DEFAULT_DB})"
    )
    parser.add_argument(
        "--plain", action="store_true",
        help="Force plain-text output even if rich is available"
    )
    args = parser.parse_args()

    conn = open_db(args.db)
    since = since_epoch(args.days)

    completed = get_completed(conn, since)
    in_progress = get_in_progress(conn)
    failed = get_failed(conn, since)
    conn.close()

    use_rich = False
    if not args.plain:
        try:
            import rich  # noqa: F401
            use_rich = True
        except ImportError:
            pass

    if use_rich:
        rich_report(completed, in_progress, failed, args.days)
    else:
        plain_report(completed, in_progress, failed, args.days)


if __name__ == "__main__":
    main()
