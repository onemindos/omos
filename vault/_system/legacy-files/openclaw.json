{
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",

      "heartbeat": {
        "every": "1m",
        "target": "last",
        "directPolicy": "allow",
        "lightContext": false,
        "model": "anthropic/claude-sonnet-4-6",
        "prompt": "Read HEARTBEAT.md. Read AMBIENT_STATE.md if it exists. You are Legacy — always-on AI presence for Zeus. Scan current state: vision digest, NATS events, active session. Surface anything actionable. If nothing needs attention, reply HEARTBEAT_OK.",
        "ackMaxChars": 500,
        "activeHours": {
          "start": "00:00",
          "end": "23:59",
          "timezone": "America/New_York"
        }
      }
    },

    "list": [
      {
        "id": "legacy",
        "default": true,
        "workspace": "~/.openclaw/workspace",
        "heartbeat": {
          "every": "1m",
          "target": "last",
          "lightContext": false,
          "model": "anthropic/claude-sonnet-4-6"
        }
      }
    ]
  },

  "model": {
    "primary": "anthropic/claude-sonnet-4-6",
    "fallback": "anthropic/claude-haiku-4-5-20251001"
  },

  "plugins": {
    "entries": {
      "discord-voice": {
        "enabled": true,
        "config": {
          "sttProvider": "local-whisper",
          "ttsProvider": "elevenlabs",
          "vadSensitivity": "medium",
          "silenceThresholdMs": 800,
          "maxRecordingMs": 60000,
          "allowedUsers": [],
          "barge_in": true,
          "elevenlabs": {
            "apiKey": "${ELEVENLABS_API_KEY}",
            "voiceId": "${LEGACY_VOICE_ID}",
            "modelId": "eleven_turbo_v2_5"
          }
        }
      },

      "camsnap": {
        "enabled": true,
        "config": {
          "cameras": {
            "desk": "rtsp://localhost:8554/desk",
            "rayban": "rtsp://localhost:8554/rayban"
          }
        }
      }
    }
  },

  "tools": {
    "media": {
      "audio": {
        "whisperModel": "base.en",
        "transcribeVoiceNotes": true
      }
    },
    "shell": {
      "enabled": true,
      "allowedCommands": ["cat", "nats", "camsnap", "ffmpeg", "date", "jq"]
    }
  },

  "contextPruning": {
    "mode": "sliding"
  },

  "compaction": {
    "mode": "safeguard"
  }
}
