# OneMind OS — Bootstrap Environment (env.sa)
# Copy to /opt/onemind/.env.sa and fill in OP_SERVICE_ACCOUNT_TOKEN.
# chmod 600 /opt/onemind/.env.sa
#
# This file has ONE secret: the 1Password service account token.
# All other secrets are fetched from 1Password by op run at runtime using env.tpl.
#
# How to get OP_SERVICE_ACCOUNT_TOKEN:
#   1. Go to my.1password.com → Developer Tools → Service Accounts
#   2. Create service account with Read/Write access to "OneMind - Unified Intelligence"
#   3. Copy the token (starts with ops_...)
#   4. Paste it below
#
# NEVER commit this file to git. NEVER share in chat.

# --- 1Password Service Account (the ONLY secret in this file) ---
OP_SERVICE_ACCOUNT_TOKEN=ops_...

# --- Static non-secret vars (safe to have here) ---
OPENCLAW_GATEWAY_URL=http://localhost:18789
OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=1
OPENCLAW_NO_RESPAWN=1
NODE_COMPILE_CACHE=/var/tmp/openclaw-compile-cache
NATS_URL=nats://localhost:4222
HOME_ASSISTANT_URL=http://homeassistant.local:8123
FRIGATE_URL=http://frigate.local:5000

# --- Discord Channel IDs (heartbeat targets, set after creating channels) ---
HEARTBEAT_CHANNEL_ID=1478866012440129671
DISCORD_GUILD_ID=1453411552181883027
# Agent channel IDs are referenced as ${DISCORD_*_CHANNEL_ID} in openclaw.json
DISCORD_SPARTAN_CHANNEL_ID=1480445911707549750
DISCORD_ORACLE_CHANNEL_ID=1480450417522643127
DISCORD_EDEN_CHANNEL_ID=1480445924202385499
DISCORD_EMPIRE_CHANNEL_ID=1480445930661744801
DISCORD_HAVEN_CHANNEL_ID=1480445937665966161
DISCORD_GUARDIAN_CHANNEL_ID=1480445943789785180
DISCORD_GRID_CHANNEL_ID=1480445951805096007
DISCORD_TRINITY_CHANNEL_ID=1480445958876827714

# --- BlueBubbles (iMessage bridge) ---
BLUEBUBBLES_SERVER_URL=http://100.114.142.55:1234
