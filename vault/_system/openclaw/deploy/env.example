# OneMind OS — Environment Variables
# Copy to /opt/onemind/.env and fill in real values.
# Loaded by systemd EnvironmentFile directive.

# --- LLM Providers ---
AZURE_OPENAI_API_KEY=                    # Azure OpenAI — primary provider (gpt-5.2, gpt-4o)
AZURE_OPENAI_ENDPOINT=                   # Azure OpenAI endpoint URL
OPENAI_API_KEY=                          # OpenAI Direct — fallback provider
ANTHROPIC_API_KEY=                       # Anthropic — fallback provider (Claude)

# --- OpenClaw Gateway ---
OPENCLAW_GATEWAY_TOKEN=                  # Gateway auth token
OPENCLAW_HOOKS_TOKEN=                    # Webhook auth token
OPENCLAW_GATEWAY_URL=http://localhost:18789
OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=1
OPENCLAW_NO_RESPAWN=1
NODE_COMPILE_CACHE=/var/tmp/openclaw-compile-cache

# --- Channels ---
DISCORD_BOT_TOKEN=                       # Discord bot token

# --- Discord IDs (guild + agent channels + heartbeat) ---
DISCORD_GUILD_ID=1453411552181883027     # One Mind OS guild
HEARTBEAT_CHANNEL_ID=                    # agent-heartbeat channel (Legacy default)
DISCORD_SPARTAN_CHANNEL_ID=              # #spartan-chat
DISCORD_ORACLE_CHANNEL_ID=              # #oracle-chat
DISCORD_EDEN_CHANNEL_ID=                # #eden-chat
DISCORD_EMPIRE_CHANNEL_ID=              # #empire-chat
DISCORD_HAVEN_CHANNEL_ID=               # #haven-chat
DISCORD_GUARDIAN_CHANNEL_ID=            # #guardian-chat
DISCORD_GRID_CHANNEL_ID=               # #grid-chat
DISCORD_TRINITY_CHANNEL_ID=            # #trinity-chat

# --- BlueBubbles (iMessage bridge) ---
BLUEBUBBLES_SERVER_URL=                  # e.g. http://100.x.x.x:1234 (Tailscale IP)
BLUEBUBBLES_PASSWORD=                    # BlueBubbles server password

# --- Voice ---
# ELEVENLABS_API_KEY=sk_                   # ElevenLabs TTS (REMOVED — Azure OpenAI TTS used instead)
# ELEVENLABS_VOICE_ID=                     # Legacy's voice ID (REMOVED)
DEEPGRAM_API_KEY=                          # Deepgram STT (Nova-3, for voice pipeline)
# TTS is now routed through AZURE_OPENAI_ENDPOINT — no separate TTS key needed

# --- 1Password (onepassword-1.0.0 skill) ---
OP_SERVICE_ACCOUNT_TOKEN=ops_...        # Service account token from 1password.com/developer
OP_VAULT_ID=                             # Default vault ID (OneMind - Unified Intelligence)

# --- Skill-specific (set as needed) ---
# CLICKUP_API_KEY=
# LOB_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# RESEND_API_KEY=
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REFRESH_TOKEN=
# HOME_ASSISTANT_URL=http://homeassistant.local:8123
# HOME_ASSISTANT_TOKEN=
# FRIGATE_URL=http://frigate.local:5000
# GITHUB_TOKEN=
# TODOIST_API_TOKEN=
# NATS_URL=nats://localhost:4222
