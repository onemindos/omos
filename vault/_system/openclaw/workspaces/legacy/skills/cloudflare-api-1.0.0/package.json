{
  "name": "cloudflare-api",
  "version": "1.0.0",
  "description": "Cloudflare DNS and zone management for OpenClaw",
  "main": "index.js",
  "tools": [
    {
      "name": "cf_zones",
      "description": "List all Cloudflare zones (domains) in the account",
      "parameters": {}
    },
    {
      "name": "cf_dns_list",
      "description": "List DNS records for a zone. Optionally filter by type or name.",
      "parameters": {
        "type": "object",
        "properties": {
          "zone": {
            "type": "string",
            "description": "Domain name (e.g. onemindos.dev)"
          },
          "record_type": {
            "type": "string",
            "description": "Filter by record type: A, AAAA, CNAME, MX, TXT, etc."
          },
          "name": {
            "type": "string",
            "description": "Filter by record name (e.g. api, www, *)"
          }
        },
        "required": ["zone"]
      }
    },
    {
      "name": "cf_dns_create",
      "description": "Create a DNS record in a zone",
      "parameters": {
        "type": "object",
        "properties": {
          "zone": {
            "type": "string",
            "description": "Domain name (e.g. onemindos.dev)"
          },
          "type": {
            "type": "string",
            "description": "Record type: A, AAAA, CNAME, MX, TXT, SRV"
          },
          "name": {
            "type": "string",
            "description": "Record name (e.g. api, www, @, *)"
          },
          "content": {
            "type": "string",
            "description": "Record value (IP address, hostname, or text)"
          },
          "proxied": {
            "type": "boolean",
            "description": "Enable Cloudflare proxy (orange cloud). Default false."
          },
          "ttl": {
            "type": "number",
            "description": "TTL in seconds. 1 = auto. Default 1."
          }
        },
        "required": ["zone", "type", "name", "content"]
      }
    },
    {
      "name": "cf_dns_update",
      "description": "Update an existing DNS record",
      "parameters": {
        "type": "object",
        "properties": {
          "zone": {
            "type": "string",
            "description": "Domain name (e.g. onemindos.dev)"
          },
          "record_id": {
            "type": "string",
            "description": "Record ID to update (get from cf_dns_list)"
          },
          "type": {
            "type": "string",
            "description": "Record type: A, AAAA, CNAME, MX, TXT"
          },
          "name": {
            "type": "string",
            "description": "Record name"
          },
          "content": {
            "type": "string",
            "description": "New record value"
          },
          "proxied": {
            "type": "boolean",
            "description": "Enable Cloudflare proxy"
          }
        },
        "required": ["zone", "record_id", "type", "name", "content"]
      }
    },
    {
      "name": "cf_dns_delete",
      "description": "Delete a DNS record",
      "parameters": {
        "type": "object",
        "properties": {
          "zone": {
            "type": "string",
            "description": "Domain name (e.g. onemindos.dev)"
          },
          "record_id": {
            "type": "string",
            "description": "Record ID to delete (get from cf_dns_list)"
          }
        },
        "required": ["zone", "record_id"]
      }
    },
    {
      "name": "cf_zone_settings",
      "description": "Get zone settings (SSL mode, security level, caching, etc.)",
      "parameters": {
        "type": "object",
        "properties": {
          "zone": {
            "type": "string",
            "description": "Domain name"
          }
        },
        "required": ["zone"]
      }
    }
  ]
}
