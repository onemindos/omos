name: health-check
description: "Every 5min system health check — gateway, NATS, OmniDB"
cron: "*/5 * * * *"
silent: true
steps:
  - tool: exec
    label: nats-ping
    input:
      cmd: "docker inspect onemind-nats --format={{.State.Health.Status}} 2>/dev/null || echo unknown"
  - tool: exec
    label: db-ping
    input:
      cmd: "docker inspect onemind-omnidb --format={{.State.Health.Status}} 2>/dev/null || echo unknown"
  - tool: sessions_send
    label: alert-if-down
    condition: "{{nats-ping.output}} != healthy || {{db-ping.output}} != healthy"
    input:
      agentId: legacy
      message: "SYSTEM ALERT: NATS={{nats-ping.output}} | OmniDB={{db-ping.output}}. Investigate and report to Discord."
