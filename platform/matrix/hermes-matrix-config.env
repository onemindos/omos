# Matrix Configuration for Hermes Agent
# Add to ~/.hermes/.env or config.yaml

# =============================================================================
# MATRIX PLATFORM CONFIGURATION
# =============================================================================

# Homeserver URL (your self-hosted Synapse)
MATRIX_HOMESERVER=https://matrix.onemindos.com

# Bot User ID (register on your homeserver first)
MATRIX_USER_ID=@hermes:onemindos.com

# Access token (get from Element: Settings → Security → Access Token)
MATRIX_ACCESS_TOKEN=syt_YOUR_ACCESS_TOKEN_HERE

# =============================================================================
# AUTHORIZATION (CRITICAL - Restrict who can trigger the agent)
# =============================================================================

# Comma-separated list of allowed Matrix user IDs
# Format: @username:domain
MATRIX_ALLOWED_USERS=@zeus:onemindos.com,@legacy:onemindos.com

# Optional: Restrict to specific rooms (room IDs, not aliases)
# MATRIX_ALLOWED_ROOMS=!roomid1:onemindos.com,!roomid2:onemindos.com

# =============================================================================
# BEHAVIOR CONFIGURATION
# =============================================================================

# Require @mention in rooms (default: true)
MATRIX_REQUIRE_MENTION=true

# Rooms where bot responds without mention (comma-separated room IDs)
# MATRIX_FREE_RESPONSE_ROOMS=!infra:onemindos.com,!alerts:onemindos.com

# Auto-create threads for bot responses in rooms (default: true)
MATRIX_AUTO_THREAD=true

# Auto-create threads for DM responses (default: false)
MATRIX_DM_AUTO_THREAD=false

# Create thread when @mentioned in DM (default: true)
MATRIX_DM_MENTION_THREADS=true

# =============================================================================
# ENCRYPTION (E2EE)
# =============================================================================

# Encryption mode: disabled, opportunistic, required
MATRIX_ENCRYPTION_MODE=opportunistic

# Encryption key backup passphrase (for key recovery)
# MATRIX_E2EE_BACKUP_PASSPHRASE=your-backup-passphrase

# =============================================================================
# MEDIA LIMITS
# =============================================================================

# Max media download size (100MB default)
MATRIX_MAX_MEDIA_BYTES=104857600

# =============================================================================
# ADVANCED
# =============================================================================

# Sync timeout (seconds)
MATRIX_SYNC_TIMEOUT=30000

# Request timeout (seconds)
MATRIX_REQUEST_TIMEOUT=30000

# Connection pool size
MATRIX_CONNECTION_POOL_SIZE=10

# =============================================================================
# PLATFORM TOOLSET (already in config.yaml)
# =============================================================================

# platform_toolsets:
#   matrix:
#     - hermes-matrix  # Includes: terminal, file, web, vision, image, tts, browser, skills, todo, cronjob, messaging