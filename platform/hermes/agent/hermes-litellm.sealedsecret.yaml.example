---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: hermes-litellm
  namespace: hermes
  annotations:
    onemind.io/rollout-gate: "do-not-apply until the Hermes virtual key is provisioned and sealed"
spec:
  encryptedData:
    HERMES_LITELLM_API_KEY: "<REPLACE_WITH_KUBESEALED_HERMES_VIRTUAL_KEY>"
  template:
    metadata:
      name: hermes-litellm
      namespace: hermes
    type: Opaque
