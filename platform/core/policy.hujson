// Tailnet policy for omos. GitOps: a PR shows the difference from the live policy and runs the tests at the
// bottom; a merge to main applies it (.github/workflows/tailscale.yml).
//
// Rule of thumb: you (every device signed in as you) reach everything. Cluster proxies (tag:k8s) reach only
// the specific machines and ports they are configured for. Nothing else is open, and Funnel (public exposure)
// is off.
{
	"groups": {
		// The only human on the tailnet.
		"group:admins": ["Zeus-Delacruz@github"],
	},

	// Tags for the Tailscale Kubernetes Operator and the proxies it creates.
	"tagOwners": {
		"tag:k8s-operator": [],
		"tag:k8s":          ["tag:k8s-operator"],
	},

	// Auto-approve services advertised by operator-managed proxies (tag:k8s),
	// so exposed cluster services join the tailnet with no manual approval.
	"autoApprovers": {
		"services": {
			"tag:k8s": ["tag:k8s"],
		},
	},

	// Names for the machines referred to below (tailnet addresses as of 2026-10-17).
	"hosts": {
		// Your devices that Hermes manages through cluster egress proxies (hermes namespace).
		"omos-mbp":       "100.74.182.117",
		"omos-s24":       "100.121.191.94",
		"omos-ha":        "100.64.25.12",
		// Cluster services on the tailnet (operator proxies).
		"argocd":         "100.121.32.110",
		"onemind-auth":   "100.98.186.54",
		"grafana":        "100.80.230.49",
		"headlamp":       "100.70.204.17",
		"opencost":       "100.115.174.112",
		"hermes-agent":   "100.103.22.42",
		"omos-nats":      "100.117.169.54",
		"tak":            "100.119.127.43",
	},

	"grants": [
		// 1. You: every device signed in as you reaches everything (admin UIs, NATS leaf port, TAK, your machines).
		{
			"src": ["group:admins"],
			"dst": ["*"],
			"ip":  ["*"],
		},

		// 2. Hermes, through the cluster egress proxies, reaches the machines it manages on the ports it uses:
		//    SSH to the Mac, the Home Assistant API, and SSH (Termux) on the phone.
		{
			"src": ["tag:k8s"],
			"dst": ["omos-mbp"],
			"ip":  ["tcp:22"],
		},
		{
			"src": ["tag:k8s"],
			"dst": ["omos-ha"],
			"ip":  ["tcp:8123"],
		},
		{
			"src": ["tag:k8s"],
			"dst": ["omos-s24"],
			"ip":  ["tcp:8022"],
		},

		// 3. Backstage reaches ArgoCD and Authentik through the mesh (backstage/argocd-mesh, backstage/authentik-mesh).
		{
			"src": ["tag:k8s"],
			"dst": ["argocd", "onemind-auth"],
			"ip":  ["tcp:443"],
		},
	],

	// Tailscale SSH: you can SSH into your own devices.
	"ssh": [
		{
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
			"action": "accept",
		},
	],

	// Funnel (public internet exposure) is not granted to anyone. Nothing uses it (checked 2026-10-17).

	// Checked on every PR and before every apply. If a test fails, the policy is not applied.
	"tests": [
		{
			// You keep full access.
			"src":    "Zeus-Delacruz@github",
			"accept": ["argocd:443", "grafana:443", "headlamp:443", "opencost:443", "hermes-agent:443", "omos-nats:7422", "tak:8089", "omos-mbp:22"],
		},
		{
			// Cluster proxies reach only what they are configured for, and none of the admin tools.
			"src":    "tag:k8s",
			"accept": ["omos-mbp:22", "omos-ha:8123", "omos-s24:8022", "argocd:443", "onemind-auth:443"],
			"deny":   ["headlamp:443", "grafana:443", "opencost:443", "hermes-agent:443", "omos-nats:7422", "omos-mbp:5900", "omos-ha:22", "omos-s24:22"],
		},
	],
}
