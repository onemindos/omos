# TEMPLATE ONLY. Not applied by Argo CD (the Application excludes *.secret*) and not a real secret.
# The real Secret is created and sealed by Zeus, see platform/stac/README.md, "Before the first sync". It ends up as
# platform/stac/webodm-api.sealedsecret.yaml. Never put the password in this file.
apiVersion: v1
kind: Secret
metadata:
  name: webodm-api
  namespace: stac
type: Opaque
stringData:
  username: "<WebODM user that can view the projects, for example stac-sync>"
  password: "<that user's WebODM password>"
