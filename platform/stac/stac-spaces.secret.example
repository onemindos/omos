# TEMPLATE ONLY. Not applied by Argo CD (the Application excludes *.secret*) and not a real secret.
# The real Secret is created and sealed by Zeus, see platform/stac/README.md, "Before the first sync". It ends up as
# platform/stac/stac-spaces.sealedsecret.yaml. Never put the key in this file.
apiVersion: v1
kind: Secret
metadata:
  name: stac-spaces
  namespace: stac
type: Opaque
stringData:
  access-key: "<Spaces access key ID, limited to the onemind-imagery bucket>"
  secret-key: "<Spaces secret key, shown once by DigitalOcean>"
