# WWV secrets — create as Kubernetes secret "wwv-env" in namespace "wwv"
# kubectl create secret generic wwv-env --from-env-file=secret.env -n wwv
#
# Required:
DATABASE_URL=postgresql://user:pass@host:5432/wwv
AUTH_SECRET=<openssl rand -hex 32>
ENCRYPTION_MASTER_KEY=<openssl rand -hex 16 (must be exactly 32 chars)>

# Optional (enhance functionality):
# NEXT_PUBLIC_CESIUM_ION_TOKEN=<from ion.cesium.com>
# OPENWEATHERMAP_API_KEY=<from openweathermap.org>
# OPENSKY_CREDENTIALS=<id:secret pairs>
