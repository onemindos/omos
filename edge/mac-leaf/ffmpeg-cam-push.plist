<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  OneMind Mac Camera Push — FaceTime HD Camera → mediamtx-tak (Tailscale)

  Pushes the MacBook FaceTime camera to mediamtx.takserver as stream "maccam".
  Available at: rtsp://mediamtx-tak-1.tail717ba0.ts.net:8554/maccam
  Also relayed to cloudtak-media for WebTAK users automatically.

  Install:
    cp edge/mac-leaf/ffmpeg-cam-push.plist ~/Library/LaunchAgents/com.onemind.ffmpeg-cam-push.plist
    launchctl load ~/Library/LaunchAgents/com.onemind.ffmpeg-cam-push.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.onemind.ffmpeg-cam-push.plist

  View logs:
    tail -f /tmp/onemind-cam-push.log

  Requirements:
    brew install ffmpeg
    Tailscale connected (mediamtx-tak must be reachable)
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.onemind.ffmpeg-cam-push</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/ffmpeg</string>
        <!-- AVFoundation: device 0 = FaceTime HD Camera (video only) -->
        <string>-f</string>
        <string>avfoundation</string>
        <string>-framerate</string>
        <string>30</string>
        <string>-video_size</string>
        <string>1280x720</string>
        <string>-i</string>
        <string>0</string>
        <!-- encode: low latency H.264 -->
        <string>-vcodec</string>
        <string>libx264</string>
        <string>-preset</string>
        <string>ultrafast</string>
        <string>-tune</string>
        <string>zerolatency</string>
        <string>-b:v</string>
        <string>800k</string>
        <string>-g</string>
        <string>30</string>
        <!-- push to mediamtx via Tailscale -->
        <string>-f</string>
        <string>rtsp</string>
        <string>-rtsp_transport</string>
        <string>tcp</string>
        <string>rtsp://mediamtx-tak-1.tail717ba0.ts.net:8554/maccam</string>
    </array>

    <!-- restart automatically on exit (connection drops, sleep, etc.) -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- start at login -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/onemind-cam-push.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/onemind-cam-push.log</string>

    <!-- needs display access for AVFoundation camera capture -->
    <key>SessionType</key>
    <string>Aqua</string>
</dict>
</plist>
