# Terraform state — contains secrets (kubeconfig, tokens). Never commit.
# Phase 2 will move state to a Spaces (S3) remote backend.
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars.secret

# Terraform lock file IS committed (pins provider hashes) — do not ignore .terraform.lock.hcl

# Local kubeconfig / secrets
kubeconfig*.yaml
*.kubeconfig
.env

# Personal vault is maintained outside this source repository.
/vault/

# Letta worktrees
/.letta/
/platform/nats/*.secret.*
/platform/nats/creds.secret.env
values.secret.yaml

# Cloudflare and other local platform secret overrides
platform/core/*.secret.env
platform/core/*.secret

# TAK Server generated private keys, certificates, and local build output — NEVER commit
tak-server/certs-out/
tak-server/certs/files/
tak-server/b2-enrollment/
tak-server/.tapvenv/
tak-server/local-retirement-backup/
tak-server/build-root/
*.key
*.jks
*.p12

# macOS noise
.DS_Store
**/.DS_Store

# Local Python bytecode and test caches
__pycache__/
*.py[cod]
.pytest_cache/
