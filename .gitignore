# Terraform state — contains secrets (kubeconfig, tokens). Never commit.
# Phase 2 will move state to a Spaces (S3) remote backend.
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars.secret

# Terraform lock file IS committed (pins provider hashes) — do not ignore .terraform.lock.hcl

# Local kubeconfig / secrets
kubeconfig*.yaml
*.kubeconfig
.env

# Letta worktrees
/.letta/
/platform/nats/*.secret.*
/platform/nats/creds.secret.env
values.secret.yaml

# Cloudflare API token
platform/cloudflare/*.secret.env
platform/cloudflare/*.secret

# TAK cluster generated private keys / certs — NEVER commit
tak-cluster/certs-out/
*.key
*.jks
*.p12

# macOS noise
.DS_Store
**/.DS_Store

# TAK bridge plugin artifacts — JAR + config ARE tracked (needed for CI image build)

# TAK client certs / CA keys — never commit
tak-cluster/b2-enrollment/
tak-cluster/.tapvenv/
*.key
*.p12

# local TAK retirement DB backup (large, disposable)
tak-cluster/local-retirement-backup/

# TAK build-root — compiled JARs/WARs, not source (large binaries, not for git)
tak-cluster/build-root/

# uptime-kuma SQLite migration dump
uptime-kuma/migration-data/
