# Copy to deploy/.env before running docker compose. Never commit deploy/.env.

# --- TAK deployment root (this ATAK folder is the single home) ---
ATAK_STACK=/Users/zeus/ATAK/server/standard/takserver-docker-5.7-RELEASE-43
ATAK_ROOT=/Users/zeus/ATAK/server/standard/takserver-docker-5.7-RELEASE-43/tak

# TAK DB password — MUST match tak/CoreConfig.xml <connection ... password> and the
# already-initialized DB volume. Do not change on an existing DB or TAK loses the schema.
TAK_DB_PASSWORD=change-me

# TAK admin cert used by status/list scripts. Password supplied at runtime via TAK_ADMIN_P12_PASS.
TAK_ADMIN_P12=/Users/zeus/ATAK/server/standard/takserver-docker-5.7-RELEASE-43/tak/certs/files/admin.p12

# --- Murmur voice (now under the ATAK home at voice/) ---
MURMUR_ROOT=/Users/zeus/ATAK/voice
MUMBLE_SUPERUSER_PASSWORD=change-me
MUMBLE_CONFIG_WELCOMETEXT=<br/>Welcome to <b>OneMind Command</b>.<br/>Sovereign voice for the fleet.
MUMBLE_CONFIG_USERS=100
MUMBLE_CONFIG_BANDWIDTH=128000

# --- Host addressing ---
LAN_IP=192.168.1.183
TAILSCALE_IP=100.74.182.117
