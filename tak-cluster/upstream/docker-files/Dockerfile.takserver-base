FROM eclipse-temurin:17-jammy
RUN apt-get update && apt-get install -y net-tools netcat-openbsd && rm -rf /var/lib/apt/lists/*
COPY tak/ /opt/tak/
RUN find /opt/tak -name "*.sh" -exec chmod +x {} \; \
    && chmod u=rwx /opt/tak \
    && find /opt/tak -type d -exec chmod u=rwx {} \;
WORKDIR /opt/tak
CMD ["jshell"]
