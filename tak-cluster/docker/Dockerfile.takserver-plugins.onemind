# OneMind plugins image = upstream takserver-plugins + Zeus's NATS bridge plugin.
#
# Base = ghcr.io/onemindos/takserver-plugins:5.8-onemind (already has takserver-pm.jar
# and takserver-plugins-cluster.sh at /opt/tak/). Build this AFTER the upstream images
# are pushed to GHCR.
#
#   docker build -f docker/Dockerfile.takserver-plugins.onemind \
#     -t ghcr.io/onemindos/takserver-plugins:5.8-onemind .
#   (build context = tak-cluster/ root — only needs plugin/ directory)
ARG TAKSERVER_IMAGE_REPO=ghcr.io/onemindos/takserver-plugins
ARG TAKSERVER_IMAGE_TAG=5.8-onemind
FROM ${TAKSERVER_IMAGE_REPO}:${TAKSERVER_IMAGE_TAG}

# --- OneMind: bake in Zeus's NATS bridge plugin -----------------------------
RUN mkdir -p /opt/tak/lib /opt/tak/conf/plugins
COPY plugin/takserver-nats-plugin-1.0.0.jar /opt/tak/lib/takserver-nats-plugin-1.0.0.jar
COPY plugin/tak.server.plugins.NatsBridgePlugin.yaml /opt/tak/conf/plugins/tak.server.plugins.NatsBridgePlugin.yaml
